{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed document event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "DocumentCommitted"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "documentId",
    "actorId",
    "sequence",
    "revision",
    "commandId",
    "type",
    "correlationId",
    "occurredAt"
  ]
}
